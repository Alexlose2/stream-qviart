# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=change-this-to-a-random-32-plus-character-secret
NEXTAUTH_URL=http://localhost:3000

# Comma-separated list of Google accounts allowed to use the panel
ALLOWED_EMAILS=alexlose2@gmail.com

# Raspberry SSH
RPI_HOST=192.168.1.50
RPI_PORT=22
RPI_USERNAME=pi

# Prefer a private key. Keep line breaks escaped as \n when storing in Vercel.
RPI_PRIVATE_KEY=

# Optional fallback if you do not use a private key
RPI_PASSWORD=

# Example: start a systemd service, script, ffmpeg, mediamtx, etc.
RPI_STREAM_COMMAND=sudo systemctl start qviart-stream.service
RPI_COMMAND_TIMEOUT_MS=20000

# Browser stream URL. Use iframe for web UIs, video for direct browser-playable streams.
NEXT_PUBLIC_STREAM_URL=http://192.168.1.50:8889/qviart/
NEXT_PUBLIC_STREAM_KIND=iframe

# Local dry-run without touching the Raspberry
DEMO_MODE=false
